---
import '../styles/global.css';
import IconDefinitions from '../components/IconDefinitions.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Aias — 保持好奇，持续构建。',
  description = 'Aias 的个人主页。Apache ShenYu PMC 成员，探索开源、基础设施与 AI Agent。这里收藏我的技术电子书和新的想法。',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#101211">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical.href}>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23101211'/%3E%3Cpath d='m18 43 14-24 14 24M23 35h18' fill='none' stroke='%23c2f970' stroke-width='5' stroke-linejoin='round'/%3E%3C/svg%3E">
  <title>{title}</title>
<link rel="canonical" href={canonical.href} />
</head>
<body id="top">
  <a class="skip-link" href="#main">跳转到主要内容</a>
  <IconDefinitions />
  <SiteHeader />
  <slot />
  <SiteFooter />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
